# 이 파일을 .env.local 로 복사해서 값을 채웁니다. (.env.local 은 Git에 올라가지 않습니다)

# ── AI 기능(OpenAI). 서버에서만 쓰는 비밀 키입니다. NEXT_PUBLIC_ 를 붙이지 마세요.
OPENAI_API_KEY=
# 선택: 모델 이름(기본값 gpt-5-mini)
# OPENAI_MODEL=gpt-5-mini
# 선택: 추론 강도(minimal|low|medium|high). 비워 두면 모델 기본값을 씁니다.
# OPENAI_REASONING_EFFORT=

# ── Supabase(나중에 연결). 공개용 Publishable key 만 넣습니다. secret / service_role 키는 넣지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
