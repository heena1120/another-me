# 이 파일을 .env.local 로 복사해서 값을 채웁니다. (.env.local 은 Git에 올라가지 않습니다)
# Supabase 대시보드 > Project Settings > API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 Publishable(anon) key 만 넣습니다. secret / service_role 키는 절대 NEXT_PUBLIC_ 변수에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 사진으로 캐릭터 만들기 등 AI 기능용. 서버에서만 쓰는 비밀 키입니다. NEXT_PUBLIC_ 를 붙이지 마세요.
ANTHROPIC_API_KEY=
